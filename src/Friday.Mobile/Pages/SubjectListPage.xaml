<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Friday.Mobile.ViewModels"
             x:Class="Friday.Mobile.Pages.SubjectListPage"
             Title="科目管理">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="添加" Command="{Binding AddSubjectCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <!-- Status Message -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Secondary}"
                Padding="10"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}">
            <Label Text="{Binding StatusMessage}"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Subject List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Subjects}"
                        SelectionMode="None"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="删除"
                                           BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubjectListViewModel}}, Path=DeleteSubjectCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border BackgroundColor="White"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="0,5">
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding Icon}" FontSize="32" VerticalOptions="Center" />
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding IsPreset, StringFormat='{}{0}'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="📚" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="暂无科目"
                           FontSize="18"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                    <Label Text="点击右上角添加"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

</ContentPage>
