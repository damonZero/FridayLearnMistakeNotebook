<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Friday.Mobile.Pages.SettingsPage"
             Title="设置">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <!-- App Info -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="应用信息"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="版本号:" TextColor="Gray" />
                        <Label Grid.Row="0" Grid.Column="1" Text="1.0.0" />

                        <Label Grid.Row="1" Grid.Column="0" Text="数据路径:" TextColor="Gray" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataPath}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="框架:" TextColor="Gray" />
                        <Label Grid.Row="2" Grid.Column="1" Text=".NET MAUI Android" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- AI Configuration -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🤖 AI 配置"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="配置 AI 模型，用于 OCR 识别、错题分析和相似题生成"
                           TextColor="Gray" />

                    <Label Text="• 🌋 火山方舟 (Ark) - 视觉识别/OCR" TextColor="Gray" />
                    <Label Text="• 🐋 DeepSeek - 错题分析/生成" TextColor="Gray" />
                    <Label Text="• 📊 Token 消耗统计和费用预估" TextColor="Gray" />

                    <Button Text="打开 AI 配置"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45" />
                </VerticalStackLayout>
            </Border>

            <!-- Data Management -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📦 数据管理"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="导出/导入数据，管理备份文件"
                           TextColor="Gray" />

                    <Button Text="打开数据管理"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45" />
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ℹ️ 关于"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="智能错题本是一款基于 AI 的学习辅助工具，帮助小学生高效管理错题，智能复习，提升学习效果。"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
