<Window x:Class="Friday.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Friday.UI.Converters"
        Title="智能错题本 - Smart Wrong Answer Book"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="False">

                <!-- App Title -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,0">
                    <TextBlock Text="智能错题本"
                               FontFamily="{StaticResource TitleFont}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Smart Wrong Answer Book"
                               FontSize="11"
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <Separator Background="#3D566E" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">

                    <!-- Home: 仪表盘 -->
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 IsChecked="True"
                                 Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="仪表盘" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Subjects: 科目管理 -->
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 Click="NavSubjects_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="科目管理" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Questions: 错题列表 -->
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 Click="NavQuestions_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="错题列表" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Review: 复习 -->
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 IsEnabled="False"
                                 Click="NavReview_Click"
                                 ToolTip="Phase 3: 复习功能">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="复习" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings: 设置 -->
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <!-- Bottom Section (Hamburger placeholder per D-07) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Separator Background="#3D566E" Margin="0,0,0,12" />
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 IsEnabled="False"
                                 ToolTip="更多功能 (即将推出)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="更多" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Content Area -->
        <DockPanel Grid.Column="1">

            <!-- Page Title Bar -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    Padding="24,16"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding CurrentPageTitle}"
                           FontFamily="{StaticResource TitleFont}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <!-- Page Content -->
            <ContentControl Content="{Binding CurrentViewModel}"
                            Margin="0" />

        </DockPanel>
    </Grid>
</Window>
