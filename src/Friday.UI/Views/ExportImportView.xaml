<UserControl x:Class="Friday.UI.Views.ExportImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">
    <StackPanel Margin="{StaticResource PageMargin}">

        <TextBlock Text="数据管理"
                   Style="{StaticResource SectionTitle}" />

        <!-- Current Data Summary -->
        <Border Style="{StaticResource CartoonCard}">
            <StackPanel>
                <TextBlock Text="当前数据"
                           Style="{StaticResource SubsectionTitle}" />
                <TextBlock>
                    <Run Text="科目: " /><Run Text="{Binding Summary.Subjects, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="  |  章节: " /><Run Text="{Binding Summary.Chapters, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="  |  知识点: " /><Run Text="{Binding Summary.KnowledgePoints, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="  |  错题: " /><Run Text="{Binding Summary.Questions, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Button Content="刷新统计"
                        Style="{StaticResource CartoonButton}"
                        Command="{Binding LoadSummaryCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Padding="16,6" />
            </StackPanel>
        </Border>

        <!-- Export Section -->
        <Border Style="{StaticResource CartoonCard}" Margin="8,16,8,8">
            <StackPanel>
                <TextBlock Text="导出数据"
                           Style="{StaticResource SubsectionTitle}" />
                <TextBlock Text="将所有数据导出为文件备份"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />
                <WrapPanel>
                    <Button Content="导出 JSON"
                            Style="{StaticResource CartoonButton}"
                            Command="{Binding ExportToJsonCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="导出 CSV"
                            Style="{StaticResource CartoonButtonSecondary}"
                            Command="{Binding ExportToCsvCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding ExportStatus}"
                           Foreground="{StaticResource SuccessBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExportStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Import Section -->
        <Border Style="{StaticResource CartoonCard}" Margin="8,8">
            <StackPanel>
                <TextBlock Text="导入数据"
                           Style="{StaticResource SubsectionTitle}" />
                <Border Background="#FFF3E0"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <TextBlock Text="⚠ 导入将覆盖现有数据，请确保已备份重要数据"
                               Foreground="{StaticResource WarningBrush}" />
                </Border>
                <Button Content="导入 JSON"
                        Style="{StaticResource CartoonButtonAccent}"
                        Command="{Binding ImportFromJsonCommand}"
                        HorizontalAlignment="Left" />
                <TextBlock Text="{Binding ImportStatus}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImportStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
