<UserControl x:Class="Friday.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <!-- Welcome Message -->
            <TextBlock Text="欢迎使用智能错题本!"
                       FontFamily="{StaticResource TitleFont}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="帮助孩子把错题变成进步的机会"
                       FontSize="16"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,24" />

            <!-- Stat Cards -->
            <WrapPanel HorizontalAlignment="Left">

                <!-- Total Subjects Card -->
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="📚" FontSize="28" Margin="0,0,0,8" />
                        <TextBlock Text="总科目"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalSubjects}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Total Questions Card -->
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="📝" FontSize="28" Margin="0,0,0,8" />
                        <TextBlock Text="总错题"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalQuestions}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Due Reviews Card -->
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="📖" FontSize="28" Margin="0,0,0,8" />
                        <TextBlock Text="待复习"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DueReviews}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- Quick Actions -->
            <TextBlock Text="快捷操作"
                       Style="{StaticResource SubsectionTitle}"
                       Margin="0,24,0,12" />

            <WrapPanel>
                <Button Content="📷 拍照录入"
                        Style="{StaticResource CartoonButtonAccent}"
                        Margin="0,0,12,0"
                        IsEnabled="False"
                        ToolTip="Phase 2: 拍照识别功能" />
                <Button Content="📖 开始复习"
                        Style="{StaticResource CartoonButtonSecondary}"
                        IsEnabled="False"
                        ToolTip="Phase 3: 复习功能" />
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
