<UserControl x:Class="Friday.UI.Views.QuestionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Friday.UI.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="错题列表" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Subject Filter -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="科目：" VerticalAlignment="Center" />
                <ComboBox Width="120" ItemsSource="{Binding Subjects}"
                          SelectedItem="{Binding SelectedSubjectFilter}"
                          DisplayMemberPath="Name" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Date From -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="从：" VerticalAlignment="Center" />
                <DatePicker Width="130" SelectedDate="{Binding DateFrom}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Date To -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="到：" VerticalAlignment="Center" />
                <DatePicker Width="130" SelectedDate="{Binding DateTo}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Error Type Filter -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="错误类型：" VerticalAlignment="Center" />
                <ComboBox Width="120" ItemsSource="{Binding ErrorTypes}"
                          SelectedItem="{Binding SelectedErrorTypeFilter}"
                          VerticalAlignment="Center" />
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="筛选" Command="{Binding ApplyFiltersCommand}"
                        Padding="10,5" VerticalAlignment="Center" />
                <Button Content="清除" Command="{Binding ClearFiltersCommand}"
                        Padding="10,5" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Sort Buttons -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="15,0,0,0">
                <TextBlock Text="排序：" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Button Content="日期" Command="{Binding SortByDateCommand}"
                        Padding="8,3" VerticalAlignment="Center" />
                <Button Content="复习次数" Command="{Binding SortByReviewCountCommand}"
                        Padding="8,3" Margin="5,0,0,0" VerticalAlignment="Center" />
                <Button Content="掌握程度" Command="{Binding SortByMasteryCommand}"
                        Padding="8,3" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Question List -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Questions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="题目" Binding="{Binding Content}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="科目" Binding="{Binding Subject.Name}" Width="80" />
                <DataGridTextColumn Header="错误类型" Binding="{Binding ErrorType}" Width="80" />
                <DataGridTextColumn Header="创建日期" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="100" />
                <DataGridTextColumn Header="复习日期" Binding="{Binding ReviewDate, StringFormat=yyyy-MM-dd}" Width="100" />
                <DataGridTextColumn Header="掌握程度" Binding="{Binding LeitnerBox}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
