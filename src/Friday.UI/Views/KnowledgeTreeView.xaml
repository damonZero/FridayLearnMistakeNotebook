<UserControl x:Class="Friday.UI.Views.KnowledgeTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Friday.UI.ViewModels">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="知识树管理" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

        <!-- Error Message -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Three-panel layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Subjects -->
            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="科目" FontSize="16" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10" />
                <ListBox ItemsSource="{Binding Subjects}"
                         SelectedItem="{Binding SelectedSubject}"
                         DisplayMemberPath="Name" />
            </DockPanel>

            <!-- Middle: Chapters -->
            <DockPanel Grid.Column="1" Margin="5,0,5,0">
                <TextBlock Text="章节" FontSize="16" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox Width="150" Text="{Binding NewChapterName, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <Button Content="添加章节" Command="{Binding AddChapterCommand}"
                            Padding="10,5" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Chapters}"
                         SelectedItem="{Binding SelectedChapter}"
                         DisplayMemberPath="Name" />
            </DockPanel>

            <!-- Right: Knowledge Points -->
            <DockPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="知识点" FontSize="16" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBox Text="{Binding NewKnowledgePointName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,5" />
                    <TextBox Text="{Binding NewKnowledgePointDescription, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,5" />
                    <Button Content="添加知识点" Command="{Binding AddKnowledgePointCommand}"
                            Padding="10,5" HorizontalAlignment="Left" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding KnowledgePoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="5">
                                <DockPanel>
                                    <Button Content="删除" DockPanel.Dock="Right"
                                            Command="{Binding DataContext.DeleteKnowledgePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="5,2" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
