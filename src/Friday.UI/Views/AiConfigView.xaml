<UserControl x:Class="Friday.UI.Views.AiConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Friday.UI.ViewModels"
             xmlns:interfaces="clr-namespace:Friday.Application.Interfaces;assembly=Friday.Application"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← 返回"
                        Command="{Binding NavigateBackCommand}"
                        Style="{StaticResource CartoonButton}"
                        Padding="10,5" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" Text="🤖 AI 模型配置"
                           FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}"/>

                <Button Grid.Column="2" Content="🔄 刷新"
                        Command="{Binding LoadConfigsCommand}"
                        Style="{StaticResource CartoonButton}"
                        Padding="10,5"/>
            </Grid>

            <!-- Status Message -->
            <Border Background="{DynamicResource SecondaryBrush}"
                    CornerRadius="8" Padding="10" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
            </Border>

            <!-- Loading Indicator -->
            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="8" Padding="10" Margin="0,0,0,20"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⏳ 加载中..." Foreground="White" HorizontalAlignment="Center"/>
            </Border>

            <!-- AI Configurations -->
            <Expander Header="🔧 API 配置" IsExpanded="True" Margin="0,0,0,20">
                <ItemsControl ItemsSource="{Binding Configs}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AiConfigItemViewModel}">
                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,10"
                                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                                <StackPanel>
                                    <!-- Task Type Header -->
                                    <TextBlock Text="{Binding TaskTypeDisplay}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,0,10"/>

                                    <!-- Provider Selection -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="提供商:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ProviderDisplays}"
                                                  SelectedIndex="{Binding SelectedProviderIndex}"
                                                  Padding="5"/>
                                    </Grid>

                                    <!-- API Key -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="API Key:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="5" FontFamily="Consolas"/>
                                    </Grid>

                                    <!-- Base URL (Optional) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Base URL:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="5" FontFamily="Consolas"/>
                                    </Grid>

                                    <!-- Model Name -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="模型:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="5"/>
                                    </Grid>

                                    <!-- Enable Toggle -->
                                    <CheckBox Content="启用此配置"
                                              IsChecked="{Binding IsEnabled}"
                                              Foreground="{DynamicResource PrimaryBrush}"
                                              Margin="0,0,0,10"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="💾 保存"
                                                Command="{Binding SaveCommand}"
                                                Style="{StaticResource CartoonButton}"
                                                Padding="15,5" Margin="0,0,10,0"/>

                                        <Button Content="🔗 测试连接"
                                                Command="{Binding TestConnectionCommand}"
                                                Style="{StaticResource CartoonButton}"
                                                Padding="15,5" Margin="0,0,10,0"
                                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"/>

                                        <TextBlock Text="{Binding TestResult}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding TestResultColor, Converter={StaticResource StringToBrushConverter}}"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- Usage Statistics -->
            <Expander Header="📊 Token 使用统计" IsExpanded="True" Margin="0,0,0,20">
                <StackPanel Margin="0,10,0,0">
                    <!-- Date Filter -->
                    <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="从:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Width="150" Margin="0,0,10,0"/>
                            <TextBlock Text="到:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Width="150" Margin="0,0,10,0"/>
                            <Button Content="🔍 查询"
                                    Command="{Binding LoadUsageSummaryCommand}"
                                    Style="{StaticResource CartoonButton}"
                                    Padding="15,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary Cards -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,15">
                        <!-- Total Requests -->
                        <Border Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="12" Padding="20" Margin="5" Width="180">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📞 总请求数" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding UsageSummary.TotalRequests}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Tokens -->
                        <Border Background="{DynamicResource SecondaryBrush}"
                                CornerRadius="12" Padding="20" Margin="5" Width="180">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔤 总 Token 数" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding UsageSummary.TotalTokens, StringFormat=N0}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Cost -->
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="12" Padding="20" Margin="5" Width="180">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💰 预估费用" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding UsageSummary.TotalEstimatedCost, StringFormat=¥0.0000}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- By Provider -->
                    <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="按提供商统计:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding UsageSummary.ByProvider.Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type interfaces:TokenUsageByProvider}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Provider}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Requests, StringFormat={}{0} 次}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Tokens, StringFormat={}{0:N0} tokens}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Cost, StringFormat=¥0.0000}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- By Task -->
                    <Border Background="White" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="按任务类型统计:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding UsageSummary.ByTask.Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type interfaces:TokenUsageByTask}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TaskType}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Requests, StringFormat={}{0} 次}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Tokens, StringFormat={}{0:N0} tokens}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Cost, StringFormat=¥0.0000}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Pricing Reference -->
            <Expander Header="💡 价格参考">
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Token 价格参考 (每 1000 tokens):" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="🌋 火山方舟 (豆包 Vision):" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="  • 输入: ¥0.008 / 输出: ¥0.02" Foreground="Gray" Margin="0,0,0,5"/>

                        <TextBlock Text="🐋 DeepSeek:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="  • deepseek-chat: 输入 ¥0.001 / 输出 ¥0.002" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBlock Text="  • deepseek-reasoner: 输入 ¥0.004 / 输出 ¥0.016" Foreground="Gray" Margin="0,0,0,5"/>

                        <TextBlock Text="🤖 OpenAI:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="  • gpt-4o: 输入 ¥0.04 / 输出 ¥0.12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBlock Text="  • gpt-4: 输入 ¥0.2 / 输出 ¥0.6" Foreground="Gray" Margin="0,0,0,5"/>

                        <TextBlock Text="🧠 Claude:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="  • claude-3-sonnet: 输入 ¥0.024 / 输出 ¥0.12" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBlock Text="  • claude-3-opus: 输入 ¥0.12 / 输出 ¥0.6" Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
