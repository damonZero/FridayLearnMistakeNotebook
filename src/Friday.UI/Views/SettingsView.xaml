<UserControl x:Class="Friday.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <TextBlock Text="设置"
                       Style="{StaticResource SectionTitle}" />

            <!-- App Info Section -->
            <Border Style="{StaticResource CartoonCard}">
                <StackPanel>
                    <TextBlock Text="应用信息"
                               Style="{StaticResource SubsectionTitle}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="版本号:"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="数据路径:"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DataPath}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="框架:"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="WPF UI Fluent + 智能错题本卡通主题"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data Management Section -->
            <Border Style="{StaticResource CartoonCard}" Margin="8,16,8,8">
                <StackPanel>
                    <TextBlock Text="数据管理"
                               Style="{StaticResource SubsectionTitle}" />
                    <TextBlock Text="导出/导入数据，管理备份文件"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <Button Content="打开数据管理"
                            Style="{StaticResource CartoonButton}"
                            Command="{Binding NavigateToExportImportCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- AI Configuration -->
            <Border Style="{StaticResource CartoonCard}" Margin="8,8">
                <StackPanel>
                    <TextBlock Text="AI 配置"
                               Style="{StaticResource SubsectionTitle}" />
                    <TextBlock Text="配置 AI 模型，用于 OCR 识别、错题分析和相似题生成"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="• 🌋 火山方舟 (Ark) - 视觉识别/OCR" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                    <TextBlock Text="• 🐋 DeepSeek - 错题分析/生成" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                    <TextBlock Text="• 📊 Token 消耗统计和费用预估" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                    <Button Content="打开 AI 配置"
                            Style="{StaticResource CartoonButton}"
                            Command="{Binding NavigateToAiConfigCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
