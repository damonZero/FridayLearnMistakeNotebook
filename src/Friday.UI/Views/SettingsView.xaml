<UserControl x:Class="Friday.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource BodyFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">

            <TextBlock Text="设置"
                       Style="{StaticResource SectionTitle}" />

            <!-- App Info Section -->
            <Border Style="{StaticResource CartoonCard}">
                <StackPanel>
                    <TextBlock Text="应用信息"
                               Style="{StaticResource SubsectionTitle}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="版本号:"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="数据路径:"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DataPath}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="框架:"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="WPF UI Fluent + 智能错题本卡通主题"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AI Configuration Placeholder -->
            <Border Style="{StaticResource CartoonCard}" Margin="8,16,8,8">
                <StackPanel>
                    <TextBlock Text="AI 配置"
                               Style="{StaticResource SubsectionTitle}" />
                    <TextBlock Text="AI 功能将在 Phase 4 中开放"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="• OCR 文字识别" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                    <TextBlock Text="• 知识点分析" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                    <TextBlock Text="• 相似题生成" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                    <TextBlock Text="• 每个任务可配置不同的 AI 模型" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,2" />
                </StackPanel>
            </Border>

            <!-- Data Management Placeholder -->
            <Border Style="{StaticResource CartoonCard}" Margin="8,8">
                <StackPanel>
                    <TextBlock Text="数据管理"
                               Style="{StaticResource SubsectionTitle}" />
                    <TextBlock Text="数据导出/导入功能将在本计划中实现"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
