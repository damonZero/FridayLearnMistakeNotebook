<UserControl x:Class="Friday.UI.Views.AddQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Friday.UI.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="600">
            <!-- Header -->
            <TextBlock Text="添加错题" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Success Message -->
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SuccessMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuccessMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Question Content -->
            <TextBlock Text="题目" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="80" Margin="0,0,0,15" />

            <!-- Correct Answer -->
            <TextBlock Text="正确答案" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="60" Margin="0,0,0,15" />

            <!-- Student Answer -->
            <TextBlock Text="学生答案" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="60" Margin="0,0,0,15" />

            <!-- Subject -->
            <TextBlock Text="科目" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ComboBox ItemsSource="{Binding Subjects}"
                      SelectedItem="{Binding SelectedSubject}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,15" />

            <!-- Error Type -->
            <TextBlock Text="错误类型" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ComboBox ItemsSource="{Binding ErrorTypes}"
                      SelectedItem="{Binding SelectedErrorType}"
                      Margin="0,0,0,15" />

            <!-- Notes -->
            <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="60" Margin="0,0,0,20" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="保存" Command="{Binding SaveQuestionCommand}"
                        Padding="30,10" FontSize="14" Margin="0,0,15,0" />
                <Button Content="清空" Command="{Binding ClearFormCommand}"
                        Padding="30,10" FontSize="14" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
